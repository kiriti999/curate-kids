# MongoDB connection for PayloadCMS
MONGODB_URI=mongodb://localhost:27017/curatedreels

# PayloadCMS secret for JWT tokens
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# PayloadCMS API URL for frontend
NEXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3000

# Feature flag for gradual PayloadCMS rollout
USE_PAYLOADCMS=true

# Optional: Cloudinary Configuration
# Only required if using Cloudinary for image uploads
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Optional: YouTube Data API
# Only required if using YouTube API for video metadata enrichment
# YOUTUBE_API_KEY=your-youtube-api-key

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================

# Login Feature Flag
# Set to "true" to require login to view videos
# Set to "false" or remove to allow public access
NEXT_PUBLIC_REQUIRE_LOGIN=false

# Frontend URL (used for password reset links)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ===========================================
# EMAIL (SMTP) CONFIGURATION
# Required for password reset functionality
# ===========================================

# SMTP server host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Set to "true" for SSL (port 465), "false" for TLS (port 587)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender details
SMTP_FROM_EMAIL=noreply@curatedreels.com
SMTP_FROM_NAME=CuratedReels
