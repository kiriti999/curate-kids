# Sanity CMS Configuration
# Required for all environments

# Sanity Project ID
# Get this from sanity.io project settings
SANITY_PROJECT_ID=your-project-id

# Sanity Dataset (usually 'production' or 'development')
SANITY_DATASET=production

# Sanity API Token
# Required for write operations (scripts, mutations)
# Get this from sanity.io project settings > API > Tokens
SANITY_TOKEN=your-api-token

# Next.js Public Environment Variables
# These are exposed to the browser
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: Cloudinary Configuration
# Only required if using Cloudinary for image uploads
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Optional: YouTube Data API
# Only required if using YouTube API for video metadata enrichment
# YOUTUBE_API_KEY=your-youtube-api-key
