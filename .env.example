# MongoDB connection for PayloadCMS
MONGODB_URI=mongodb://localhost:27017/curatekids

# PayloadCMS secret for JWT tokens
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# PayloadCMS API URL for frontend
NEXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3000

# Feature flag for gradual PayloadCMS rollout
USE_PAYLOADCMS=true

# Optional: Cloudinary Configuration
# Only required if using Cloudinary for image uploads
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Optional: YouTube Data API
# Only required if using YouTube API for video metadata enrichment
# YOUTUBE_API_KEY=your-youtube-api-key
