# Dependencies
/node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
!.env.example

# Bot directory
bot/node_modules
bot/dist
bot/.env
!bot/.env.example

~/.amplify/*

.next

node_modules
*.map
packages/*/dist/

# Rust / Tauri build output
**/target/
**/src-tauri/gen/

# Deployment bundles (too large for git, should be downloaded/generated)
.curatedreels-bundles/
*.tar.gz
*.zip
release-bundles/
release-staging/
output/
