# Environment Variables for CuratedReels Bot

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Webhook Configuration (for production - leave empty for polling mode)
WEBHOOK_URL=https://your-bot-domain.deno.dev/webhook
USE_POLLING=false

# Telegram Group (for organization linking and management)
# Get this from your Telegram group (it will be a negative number like -1001234567890)
TELEGRAM_GROUP=your-telegram-group-chat-id

# MongoDB Atlas (Database - Direct Connection)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/curatekids?retryWrites=true&w=majority

# Payload CMS API URL (for organization management)
PAYLOAD_API_URL=http://localhost:3000/api

# CMS URL (for account linking - users will be redirected here to login)
# This should point to your CMS deployment, not the frontend
CMS_URL=http://localhost:3000

# Frontend URL (public-facing website)
FRONTEND_URL=http://localhost:3001

# Cloudinary (Video Upload Service)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# YouTube API (Metadata Extraction)
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================================================
# APPROVAL WORKFLOW
# =============================================================================
# Set to "true" to auto-approve all videos (no admin review needed)
# Set to "false" to require admin approval for each video (default)
# This can be overridden per-organization in the admin panel
AUTO_APPROVE_VIDEOS=false
