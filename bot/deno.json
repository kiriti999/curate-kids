{
  "name": "curatedreels-telegram-bot",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "unstable": ["kv"],
  "tasks": {
    "dev": "deno run --watch --unstable-kv --allow-net --allow-env --allow-import --allow-sys --allow-read --env=.env.local src/main.ts",
    "start": "deno run --unstable-kv --allow-net --allow-env --allow-import --allow-sys --env src/main.ts"
  },
  "imports": {
    "grammy": "npm:grammy@1.30.0"
  },
  "deploy": {
    "org": "kiriti999",
    "app": "curatekids",
    "exclude": [
      "**/node_modules"
    ],
    "entrypoint": "src/main.ts"
  }
}





















