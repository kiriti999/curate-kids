{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PayloadCMS Videos Collection Schema",
  "description": "Schema definition for the 'videos' collection in PayloadCMS with MongoDB Atlas backend. This schema defines the structure for curated video content managed by the CuratedReels Telegram bot.",
  "version": "1.0.0",
  "type": "object",
  "required": ["title", "slug", "category", "ageRange", "source"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Human-readable video title",
      "minLength": 1,
      "maxLength": 500,
      "examples": [
        "Fun Science Experiment: Volcano Eruption for Kids",
        "Bedtime Story: The Little Prince"
      ]
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique identifier for the video",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 96,
      "examples": [
        "fun-science-experiment-volcano-eruption-for-kids",
        "bedtime-story-the-little-prince"
      ]
    },
    "youtubeUrl": {
      "type": ["string", "null"],
      "description": "Full YouTube video URL. Required when source='url', null otherwise.",
      "format": "uri",
      "pattern": "^https?://(?:www\\.)?(?:youtube\\.com/watch\\?v=|youtu\\.be/).*$",
      "examples": ["https://www.youtube.com/watch?v=dQw4w9WgXcQ"]
    },
    "youtubeId": {
      "type": ["string", "null"],
      "description": "YouTube video identifier (11 characters). Required when source='url', null otherwise.",
      "pattern": "^[a-zA-Z0-9_-]{11}$",
      "examples": ["dQw4w9WgXcQ"]
    },
    "cloudinaryUrl": {
      "type": ["string", "null"],
      "description": "Cloudinary hosted video URL. Required when source='telegram', null otherwise.",
      "format": "uri",
      "pattern": "^https://res\\.cloudinary\\.com/.*$",
      "examples": [
        "https://res.cloudinary.com/demo/video/upload/curatedreels/telegram-videos/story123.mp4"
      ]
    },
    "cloudinaryId": {
      "type": ["string", "null"],
      "description": "Cloudinary public ID including folder path. Required when source='telegram', null otherwise.",
      "minLength": 1,
      "examples": ["curatedreels/telegram-videos/story123"]
    },
    "thumbnailUrl": {
      "type": ["string", "null"],
      "description": "Video thumbnail image URL",
      "format": "uri",
      "examples": [
        "https://i.ytimg.com/vi/dQw4w9WgXcQ/maxresdefault.jpg",
        "https://res.cloudinary.com/demo/video/upload/c_thumb,w_400,h_225/curatedreels/telegram-videos/story123.jpg"
      ]
    },
    "duration": {
      "type": ["integer", "null"],
      "description": "Video length in seconds",
      "minimum": 0,
      "maximum": 86400,
      "examples": [180, 420]
    },
    "category": {
      "type": "string",
      "description": "Content category for subject matter classification",
      "enum": [
        "education",
        "entertainment",
        "music",
        "science",
        "arts-crafts",
        "sports",
        "nature",
        "stories"
      ],
      "examples": ["science", "stories"]
    },
    "ageRange": {
      "type": "string",
      "description": "Target audience age group aligned with child development stages",
      "enum": ["0-2", "3-5", "6-8", "9-12", "13+"],
      "examples": ["6-8", "3-5"]
    },
    "tags": {
      "type": "array",
      "description": "Descriptive keywords for the video",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "maxItems": 20,
      "uniqueItems": true,
      "examples": [
        ["experiment", "volcano", "science", "fun", "educational"],
        ["bedtime", "story", "animation", "classic"]
      ]
    },
    "source": {
      "type": "string",
      "description": "Video origin type: 'url' for external platforms, 'telegram' for direct uploads",
      "enum": ["url", "telegram"],
      "examples": ["url", "telegram"]
    },
    "createdAt": {
      "type": "string",
      "description": "Submission timestamp (ISO 8601 format). Auto-generated by PayloadCMS.",
      "format": "date-time",
      "readOnly": true,
      "examples": ["2026-01-15T10:30:00.000Z"]
    },
    "updatedAt": {
      "type": "string",
      "description": "Last modification timestamp (ISO 8601 format). Auto-updated by PayloadCMS.",
      "format": "date-time",
      "readOnly": true,
      "examples": ["2026-01-15T10:30:00.000Z"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "url"
          }
        }
      },
      "then": {
        "required": ["youtubeUrl", "youtubeId"],
        "properties": {
          "cloudinaryUrl": {
            "type": "null"
          },
          "cloudinaryId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "telegram"
          }
        }
      },
      "then": {
        "required": ["cloudinaryUrl", "cloudinaryId"],
        "properties": {
          "youtubeUrl": {
            "type": "null"
          },
          "youtubeId": {
            "type": "null"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "title": "Fun Science Experiment: Volcano Eruption for Kids",
      "slug": "fun-science-experiment-volcano-eruption-for-kids",
      "youtubeUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
      "youtubeId": "dQw4w9WgXcQ",
      "cloudinaryUrl": null,
      "cloudinaryId": null,
      "thumbnailUrl": "https://i.ytimg.com/vi/dQw4w9WgXcQ/maxresdefault.jpg",
      "duration": 180,
      "category": "science",
      "ageRange": "6-8",
      "tags": ["experiment", "volcano", "science", "fun", "educational"],
      "source": "url",
      "createdAt": "2026-01-15T10:30:00.000Z",
      "updatedAt": "2026-01-15T10:30:00.000Z"
    },
    {
      "title": "Bedtime Story: The Little Prince",
      "slug": "bedtime-story-the-little-prince",
      "youtubeUrl": null,
      "youtubeId": null,
      "cloudinaryUrl": "https://res.cloudinary.com/demo/video/upload/curatedreels/telegram-videos/story123.mp4",
      "cloudinaryId": "curatedreels/telegram-videos/story123",
      "thumbnailUrl": "https://res.cloudinary.com/demo/video/upload/c_thumb,w_400,h_225/curatedreels/telegram-videos/story123.jpg",
      "duration": 420,
      "category": "stories",
      "ageRange": "3-5",
      "tags": ["bedtime", "story", "animation", "classic"],
      "source": "telegram",
      "createdAt": "2026-01-16T20:15:00.000Z",
      "updatedAt": "2026-01-16T20:15:00.000Z"
    }
  ],
  "definitions": {
    "indexes": {
      "description": "Recommended MongoDB indexes for the videos collection",
      "value": [
        {
          "name": "slug_unique",
          "keys": { "slug": 1 },
          "options": { "unique": true }
        },
        {
          "name": "category_idx",
          "keys": { "category": 1 }
        },
        {
          "name": "ageRange_idx",
          "keys": { "ageRange": 1 }
        },
        {
          "name": "category_ageRange_compound",
          "keys": { "category": 1, "ageRange": 1 }
        },
        {
          "name": "title_tags_text",
          "keys": { "title": "text", "tags": "text" }
        },
        {
          "name": "createdAt_desc",
          "keys": { "createdAt": -1 }
        }
      ]
    }
  },
  "additionalProperties": false,
  "_metadata": {
    "payloadCMSConfig": {
      "slug": "videos",
      "admin": {
        "useAsTitle": "title",
        "defaultColumns": ["title", "category", "ageRange", "source", "createdAt"],
        "group": "Content"
      },
      "access": {
        "read": "public",
        "create": "authenticated",
        "update": "authenticated",
        "delete": "authenticated"
      },
      "timestamps": true,
      "versions": {
        "drafts": false
      }
    },
    "apiEndpoints": {
      "base": "/api/videos",
      "create": "POST /api/videos",
      "read": "GET /api/videos/:id",
      "update": "PATCH /api/videos/:id",
      "delete": "DELETE /api/videos/:id",
      "list": "GET /api/videos?limit=10&page=1",
      "filter": "GET /api/videos?where[category][equals]=science&where[ageRange][equals]=6-8"
    },
    "authentication": {
      "method": "API Key",
      "header": "Authorization: users API-Key YOUR_API_KEY",
      "description": "API keys are generated in the PayloadCMS Admin Panel under Settings > API Keys"
    }
  }
}
