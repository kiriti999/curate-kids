{
  "name": "curatekids-payloadcms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:payload": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "payload build && tsc",
    "payload:build": "payload build",
    "payload:generate:types": "payload generate:types",
    "migrate:export": "tsx migration/export-from-sanity.ts",
    "migrate:transform": "tsx migration/transform-data.ts",
    "migrate:import": "tsx migration/import-to-payloadcms.ts",
    "migrate:import:dry-run": "tsx migration/import-to-payloadcms.ts --dry-run",
    "migrate:verify": "tsx migration/verify-migration.ts",
    "migrate:all": "npm run migrate:export && npm run migrate:transform && npm run migrate:import && npm run migrate:verify"
  },
  "keywords": [
    "payloadcms"
  ],
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.72.0",
    "@payloadcms/richtext-slate": "^3.72.0",
    "express": "^5.2.1",
    "payload": "^3.72.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "react-icons": "^3.11.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
