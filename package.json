{
  "name": "curatedreels-payloadcms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NODE_ENV=development && next dev -p 4002",
    "build": "NODE_ENV=production && next build",
    "start": "NODE_ENV=production && next start -p 4002",
    "payload:generate:types": "payload generate:types",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "cleanup:orgs": "tsx scripts/cleanup-orphaned-orgs.ts",
    "cleanup:orgs:dry-run": "tsx scripts/cleanup-orphaned-orgs.ts --dry-run",
    "cleanup:orgs:manual": "tsx scripts/cleanup-orgs-manual.ts",
    "delete:videos": "tsx scripts/delete-user-videos.ts",
    "bot:leave-groups": "tsx scripts/bot-leave-groups.ts",
    "migrate:export": "tsx migration/export-from-sanity.ts",
    "migrate:transform": "tsx migration/transform-data.ts",
    "migrate:import": "tsx migration/import-to-payloadcms.ts",
    "migrate:import:dry-run": "tsx migration/import-to-payloadcms.ts --dry-run",
    "migrate:verify": "tsx migration/verify-migration.ts",
    "migrate:all": "npm run migrate:export && npm run migrate:transform && npm run migrate:import && npm run migrate:verify",
    "release": "./scripts/publish-release.sh auto patch",
    "release:minor": "./scripts/publish-release.sh auto minor",
    "release:major": "./scripts/publish-release.sh auto major",
    "release:version": "./scripts/publish-release.sh",
    "deploy:bot": "./scripts/deploy-bot.sh",
    "license:create": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts create",
    "license:list": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts list",
    "license:info": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts info",
    "license:verify": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts verify",
    "license:stats": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts stats",
    "license:revoke": "DOTENV_CONFIG_PATH=packages/admin-cli/.env tsx packages/admin-cli/src/index.ts revoke",
    "deploy:lambda": "cd lambda-functions && bash deploy.sh"
  },
  "keywords": [
    "payloadcms"
  ],
  "dependencies": {
    "@builder.io/partytown": "0.10.2",
    "@payloadcms/db-mongodb": "3.73.0",
    "@payloadcms/email-nodemailer": "^3.73.0",
    "@payloadcms/next": "3.73.0",
    "@payloadcms/richtext-lexical": "3.73.0",
    "@payloadcms/ui": "3.73.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/jsonwebtoken": "^9.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.12.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "payload": "3.73.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/eslint-plugin-next": "^16.1.3",
    "@types/inquirer": "^9.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.1",
    "@typescript-eslint/parser": "^8.53.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.28",
    "eslint-config-next": "^16.1.3",
    "inquirer": "^13.2.0",
    "mongodb": "^7.0.0",
    "nodemailer": "^7.0.12",
    "ora": "^9.0.0",
    "prettier": "^3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
