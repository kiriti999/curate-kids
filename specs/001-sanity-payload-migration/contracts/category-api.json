{
  "openapi": "3.1.0",
  "info": {
    "title": "PayloadCMS Category API",
    "version": "1.0.0",
    "description": "REST API endpoints for hierarchical Category collection in PayloadCMS"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    },
    {
      "url": "https://cms.curatekids.com/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/categories": {
      "get": {
        "summary": "List categories",
        "description": "Retrieve a list of categories with optional filtering and hierarchy traversal",
        "operationId": "listCategories",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of results per page"
          },
          {
            "name": "where[ageRange][equals]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by age range"
          },
          {
            "name": "where[parent][equals]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by parent category ID (null for root categories)"
          },
          {
            "name": "where[isAgeRangeRoot][equals]",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter for age range root categories"
          },
          {
            "name": "where[isVisible][equals]",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Filter by visibility"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["sortOrder", "-sortOrder", "name", "-name", "depth", "-depth"]
            },
            "description": "Sort field"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    },
                    "totalDocs": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create category",
        "description": "Create a new category with automatic hierarchy calculations",
        "operationId": "createCategory",
        "tags": ["Category"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (circular reference, depth limit, parent mismatch)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "summary": "Get category by ID",
        "description": "Retrieve a single category with all calculated fields",
        "operationId": "getCategoryById",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "404": {
            "description": "Category not found"
          }
        }
      },
      "patch": {
        "summary": "Update category",
        "description": "Update category (triggers recalculation of hierarchy fields)",
        "operationId": "updateCategory",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "404": {
            "description": "Category not found"
          }
        }
      },
      "delete": {
        "summary": "Delete category",
        "description": "Delete category (only if no children or videos assigned)",
        "operationId": "deleteCategory",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted successfully"
          },
          "400": {
            "description": "Cannot delete category with children or videos"
          },
          "404": {
            "description": "Category not found"
          }
        }
      }
    },
    "/categories/{id}/children": {
      "get": {
        "summary": "Get category children",
        "description": "Retrieve all direct children of a category",
        "operationId": "getCategoryChildren",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Parent category ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Category not found"
          }
        }
      }
    },
    "/categories/{id}/ancestors": {
      "get": {
        "summary": "Get category ancestors",
        "description": "Retrieve all ancestor categories (breadcrumb path)",
        "operationId": "getCategoryAncestors",
        "tags": ["Category"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  },
                  "description": "Array of ancestor categories from root to parent"
                }
              }
            }
          },
          "404": {
            "description": "Category not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Category name"
          },
          "slug": {
            "type": "string",
            "maxLength": 96,
            "description": "URL-safe identifier"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Category description"
          },
          "icon": {
            "type": "object",
            "description": "Category icon/image reference"
          },
          "ageRange": {
            "type": "string",
            "description": "Age range this category belongs to"
          },
          "parent": {
            "type": "string",
            "nullable": true,
            "description": "Parent category ID (null for root)"
          },
          "fullPath": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "readOnly": true,
            "description": "Complete path from root to this category"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "readOnly": true,
            "description": "Depth in hierarchy (0 for age ranges)"
          },
          "isAgeRangeRoot": {
            "type": "boolean",
            "readOnly": true,
            "description": "True for predefined age range categories"
          },
          "sortOrder": {
            "type": "integer",
            "description": "Custom ordering within siblings"
          },
          "isVisible": {
            "type": "boolean",
            "default": true,
            "description": "Show in frontend navigation"
          },
          "childCount": {
            "type": "integer",
            "readOnly": true,
            "description": "Number of direct children"
          },
          "videoCount": {
            "type": "integer",
            "readOnly": true,
            "description": "Number of videos in this category"
          },
          "notes": {
            "type": "string",
            "description": "Admin notes (internal only)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": ["id", "name", "slug", "ageRange", "depth"]
      },
      "CategoryInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "ageRange": {
            "type": "string"
          },
          "parent": {
            "type": "string",
            "nullable": true,
            "description": "Parent category ID (omit for root categories)"
          },
          "sortOrder": {
            "type": "integer"
          },
          "isVisible": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["name", "ageRange"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
