# CuratedReels Template - Environment Variables
# Copy this file and fill in your values

# ============================================================================
# CUSTOMER INFORMATION
# ============================================================================
CUSTOMER_NAME=your-brand-name
ADMIN_EMAIL=admin@example.com

# ============================================================================
# DATABASE (MongoDB Atlas)
# ============================================================================
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/curatekids?retryWrites=true&w=majority

# ============================================================================
# HOSTING TOKENS
# ============================================================================
# Vercel: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Deno Deploy: https://dash.deno.com/account#access-tokens
DENO_TOKEN=

# ============================================================================
# TELEGRAM BOT
# ============================================================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ============================================================================
# CLOUDINARY (Video Storage)
# ============================================================================
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# YOUTUBE API (Optional - for video metadata)
# ============================================================================
# Get from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=

# ============================================================================
# TELEGRAM AGE GROUPS
# ============================================================================
# Create 5 private groups on Telegram, add your bot as admin
# Get group IDs using @userinfobot or by forwarding a message from the group

# Group for content age 0-2 years
GROUP_0_2=

# Group for content age 3-5 years
GROUP_3_5=

# Group for content age 6-8 years
GROUP_6_8=

# Group for content age 9-12 years
GROUP_9_12=

# Group for content age 13+ years
GROUP_13_PLUS=

# ============================================================================
# CUSTOM DOMAIN (Optional)
# ============================================================================
# Leave empty to use default Vercel domain
CUSTOM_DOMAIN=

# ============================================================================
# PAYLOAD CMS (Auto-generated)
# ============================================================================
# This will be auto-generated during provisioning
PAYLOAD_SECRET=
