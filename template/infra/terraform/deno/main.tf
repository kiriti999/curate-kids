# CuratedReels Template - Deno Deploy Configuration
# Note: Deno Deploy doesn't have an official Terraform provider
# This file documents the configuration; actual deployment uses deployctl CLI

# Deno Deploy Project Configuration (for reference)
# Actual deployment is done via scripts/deploy-bot.sh

locals {
  deno_project_name = "${var.project_name}-bot"
  
  deno_env_vars = {
    TELEGRAM_BOT_TOKEN    = var.telegram_bot_token
    MONGODB_URI           = var.mongodb_uri
    CLOUDINARY_CLOUD_NAME = var.cloudinary_cloud_name
    CLOUDINARY_API_KEY    = var.cloudinary_api_key
    CLOUDINARY_API_SECRET = var.cloudinary_api_secret
    YOUTUBE_API_KEY       = var.youtube_api_key
    GROUP_0_2             = var.telegram_group_0_2
    GROUP_3_5             = var.telegram_group_3_5
    GROUP_6_8             = var.telegram_group_6_8
    GROUP_9_12            = var.telegram_group_9_12
    GROUP_13_PLUS         = var.telegram_group_13_plus
  }
}

# Output the deployment command
output "deno_deploy_command" {
  description = "Command to deploy bot to Deno Deploy"
  value       = "deployctl deploy --project=${local.deno_project_name} --token=$DENO_TOKEN apps/bot/src/main.ts"
}

output "deno_project_name" {
  description = "Deno Deploy project name"
  value       = local.deno_project_name
}

output "deno_webhook_url" {
  description = "Webhook URL for Telegram bot"
  value       = "https://${local.deno_project_name}.deno.dev/webhook"
}

# Generate .env file for bot
resource "local_file" "bot_env" {
  filename = "${path.module}/../../../apps/bot/.env"
  content  = <<-EOT
    # Auto-generated by Terraform
    # Customer: ${var.project_name}
    
    TELEGRAM_BOT_TOKEN=${var.telegram_bot_token}
    MONGODB_URI=${var.mongodb_uri}
    
    # Cloudinary
    CLOUDINARY_CLOUD_NAME=${var.cloudinary_cloud_name}
    CLOUDINARY_API_KEY=${var.cloudinary_api_key}
    CLOUDINARY_API_SECRET=${var.cloudinary_api_secret}
    
    # YouTube
    YOUTUBE_API_KEY=${var.youtube_api_key}
    
    # Telegram Groups
    GROUP_0_2=${var.telegram_group_0_2}
    GROUP_3_5=${var.telegram_group_3_5}
    GROUP_6_8=${var.telegram_group_6_8}
    GROUP_9_12=${var.telegram_group_9_12}
    GROUP_13_PLUS=${var.telegram_group_13_plus}
  EOT
}
