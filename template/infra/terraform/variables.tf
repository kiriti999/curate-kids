# CuratedReels Template - Terraform Variables
# These are passed via terraform.tfvars (auto-generated by provision.ts)

variable "vercel_token" {
  description = "Vercel API access token"
  type        = string
  sensitive   = true
}

variable "deno_token" {
  description = "Deno Deploy API access token"
  type        = string
  sensitive   = true
}

variable "project_name" {
  description = "Project name (slugified customer name)"
  type        = string
}

variable "mongodb_uri" {
  description = "MongoDB connection string"
  type        = string
  sensitive   = true
}

variable "telegram_bot_token" {
  description = "Telegram Bot API token"
  type        = string
  sensitive   = true
}

variable "cloudinary_cloud_name" {
  description = "Cloudinary cloud name"
  type        = string
}

variable "cloudinary_api_key" {
  description = "Cloudinary API key"
  type        = string
  sensitive   = true
}

variable "cloudinary_api_secret" {
  description = "Cloudinary API secret"
  type        = string
  sensitive   = true
}

variable "youtube_api_key" {
  description = "YouTube Data API key (optional)"
  type        = string
  default     = ""
  sensitive   = true
}

variable "custom_domain" {
  description = "Custom domain for frontend (optional)"
  type        = string
  default     = ""
}

# Telegram Group IDs (set during setup)
variable "telegram_group_0_2" {
  description = "Telegram group ID for age 0-2"
  type        = string
  default     = ""
}

variable "telegram_group_3_5" {
  description = "Telegram group ID for age 3-5"
  type        = string
  default     = ""
}

variable "telegram_group_6_8" {
  description = "Telegram group ID for age 6-8"
  type        = string
  default     = ""
}

variable "telegram_group_9_12" {
  description = "Telegram group ID for age 9-12"
  type        = string
  default     = ""
}

variable "telegram_group_13_plus" {
  description = "Telegram group ID for age 13+"
  type        = string
  default     = ""
}
