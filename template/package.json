{
  "name": "curatekids-template",
  "version": "1.0.0",
  "description": "White-label video curation platform for kids - Template",
  "private": true,
  "type": "module",
  "scripts": {
    "provision": "npx tsx scripts/provision.ts",
    "setup:mongo": "npx tsx scripts/setup-mongo.ts",
    "validate": "npx tsx scripts/validate-env.ts",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:bot": "bash scripts/deploy-bot.sh",
    "terraform:init": "cd infra/terraform && terraform init",
    "terraform:plan": "cd infra/terraform && terraform plan",
    "terraform:apply": "cd infra/terraform && terraform apply",
    "dev:frontend": "cd apps/frontend && pnpm dev",
    "dev:bot": "cd apps/bot && deno task dev",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "mongodb": "^6.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "PROPRIETARY",
  "keywords": [
    "curatekids",
    "video-curation",
    "kids",
    "telegram-bot",
    "nextjs",
    "payload-cms"
  ]
}
